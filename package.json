{
  "name": "@emoeem/dracpanel",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "prebuild": "node scripts/ensure-generated.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gen-licenses.mjs",
    "preview": "vite preview",
    "generate": "buf generate && node scripts/gen-icons.mjs",
    "generate:dev": "cp \"${SINGBOX_PROTO:-../sing-box/daemon/started_service.proto}\" proto/daemon/started_service.proto && buf generate",
    "lint": "eslint src scripts eslint.config.js vite.config.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings=0",
    "*.css": "stylelint --fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror-json5": "^1.0.3",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@eslint/js": "^10.0.1",
    "@material-design-icons/svg": "^0.14.15",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "description": "FlClash-style web panel for a local proxy core"
}
