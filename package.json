{
  "name": "@emoeem/dracpanel",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "prebuild": "node scripts/ensure-generated.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gen-licenses.mjs",
    "preview": "vite preview",
    "generate": "buf generate && node scripts/gen-icons.mjs && node scripts/gen-terminal-themes.mjs",
    "generate:dev": "cp \"${SINGBOX_PROTO:-../sing-box/daemon/started_service.proto}\" proto/daemon/started_service.proto && buf generate",
    "lint": "eslint src scripts eslint.config.js vite.config.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings=0",
    "*.css": "stylelint --fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror-json5": "^1.0.3",
    "luby-transform": "0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "topojson-client": "3.1.0",
    "uqr": "^0.1.3",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@material-design-icons/svg": "^0.14.15",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "DracPanel: unofficial Dracula-themed desktop panel for sing-box"
}
